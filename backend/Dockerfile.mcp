# Build
FROM golang:1.26-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -o /app/kanban-mcp ./cmd/mcp

# Runtime
FROM alpine:3.21
RUN apk --no-cache add ca-certificates
COPY --from=build /app/kanban-mcp /usr/local/bin/kanban-mcp
ENV KANBAN_API_URL=http://app:8080
CMD ["kanban-mcp"]
